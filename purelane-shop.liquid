<!-- ================= SHOP ================= -->
<section class="sec" id="shop" data-scene="3">

  <div class="wrap">

    <!-- SHOP HEADER -->
    <div class="panel-head rv">

      <span class="kicker">
        {{ section.settings.eyebrow }}
      </span>

      <h2 class="d2" style="margin-top:12px">
        {{ section.settings.heading }}
      </h2>

      <div class="rule">
        <i></i>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="lede" style="margin:14px auto 0">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>


    <!-- PRODUCT SOURCE -->
    {% if section.settings.collection != blank %}

      {% assign shop_products = section.settings.collection.products %}

    {% else %}

      {% assign shop_products = collections.all.products %}

    {% endif %}


    <!-- PRODUCT GRID -->
    <div class="shelf">

      {% for product in shop_products limit: section.settings.products_to_show %}

        {% case forloop.index %}

          {% when 1 %}
            {% assign product_art = 'p-tap' %}
            {% assign product_badge = 'Best seller' %}
            {% assign product_reviews = '237 reviews' %}

          {% when 2 %}
            {% assign product_art = 'p-kitchen' %}
            {% assign product_badge = 'Best seller' %}
            {% assign product_reviews = '254 reviews' %}

          {% when 3 %}
            {% assign product_art = 'p-metal' %}
            {% assign product_badge = 'Top rated' %}
            {% assign product_reviews = '231 reviews' %}

          {% when 4 %}
            {% assign product_art = 'p-wm' %}
            {% assign product_badge = 'New' %}
            {% assign product_reviews = '183 reviews' %}

          {% when 5 %}
            {% assign product_art = 'p-toilet' %}
            {% assign product_badge = 'Best seller' %}
            {% assign product_reviews = '219 reviews' %}

          {% when 6 %}
            {% assign product_art = 'p-laundry' %}
            {% assign product_badge = 'Popular' %}
            {% assign product_reviews = '198 reviews' %}

          {% else %}
            {% assign product_art = 'p-kitchen' %}
            {% assign product_badge = 'Popular' %}
            {% assign product_reviews = '180 reviews' %}

        {% endcase %}


        <!-- PRODUCT CARD -->
        <article class="glass card rv">

          <!-- PRODUCT IMAGE -->
          <a
            href="{{ product.url }}"
            class="shop-card-link"
            aria-label="{{ product.title | escape }}"
          >

            <div class="shot">

              <span class="pill">
                {{ product_badge }}
              </span>

              <span
                class="pimg {{ product_art }}"
                role="img"
                aria-label="{{ product.title | escape }}"
              ></span>

            </div>


            <!-- PRODUCT TITLE -->
            <h4>
              {{ product.title }}
            </h4>


            <!-- RATING -->
            <div class="rate">
              <b>★ 4.8</b>
              · {{ product_reviews }}
            </div>


            <!-- PRICE -->
            <div class="pr">

              <strong>
                {{ product.price | money }}
              </strong>

              {% if product.compare_at_price > product.price %}

                <s>
                  {{ product.compare_at_price | money }}
                </s>

                {% assign discount_amount =
                  product.compare_at_price
                  | minus: product.price
                %}

                {% assign discount_percent =
                  discount_amount
                  | times: 100
                  | divided_by: product.compare_at_price
                %}

                <em>
                  {{ discount_percent }}% off
                </em>

              {% endif %}

            </div>

          </a>


          <!-- ADD TO CART -->
          {% if product.available %}

            <form
              method="post"
              action="{{ routes.cart_add_url }}"
              class="shop-cart-form"
            >

              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <input
                type="hidden"
                name="quantity"
                value="1"
              >

              <button
                type="submit"
                class="btn btn-ghost btn-sm shop-cart-button"
              >
                {{ section.settings.button_text }}
              </button>

            </form>

          {% else %}

            <a
              href="{{ product.url }}"
              class="btn btn-ghost btn-sm shop-cart-button"
              style="opacity:.65"
            >
              View product
            </a>

          {% endif %}

        </article>

      {% else %}

        <!-- NO PRODUCTS -->
        <div
          class="glass"
          style="
            grid-column:1/-1;
            padding:45px 25px;
            text-align:center;
          "
        >

          <h3 class="d3">
            No products yet
          </h3>

          <p class="body-s" style="margin-top:10px">
            Add your Purelane products in Shopify and they will appear here.
          </p>

        </div>

      {% endfor %}

    </div>


    <!-- VIEW ALL -->
    {% if section.settings.view_all_text != blank %}

      <div
        style="
          display:flex;
          justify-content:center;
          margin-top:24px;
        "
      >

        <a
          href="{% if section.settings.collection != blank %}{{ section.settings.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          class="btn btn-primary"
        >

          {{ section.settings.view_all_text }}

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h13"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>

        </a>

      </div>

    {% endif %}

  </div>

</section>


<style>

  /* SHOP PRODUCT LINK */

  .shop-card-link {
    display:block;
    color:inherit;
    text-decoration:none;
  }


  /* CART FORM */

  .shop-cart-form {
    width:100%;
    margin-top:auto;
  }


  .shop-cart-button {
    width:100%;
    justify-content:center;
  }


  /* KEEP ORIGINAL PRODUCT ARTWORK */

  .purelane-shop .pimg {
    display:block;
    background-repeat:no-repeat;
    background-position:center bottom;
    background-size:contain;
    flex:0 0 auto;
  }


  /* MOBILE */

  @media(max-width:859px) {

    .purelane-shop .card {
      min-width:0;
    }

  }

</style>


<script>

  document.addEventListener('submit', function(event) {

    const form = event.target.closest('.shop-cart-form');

    if (!form) return;

    event.preventDefault();

    const button = form.querySelector('.shop-cart-button');

    if (button) {
      button.disabled = true;
      button.textContent = 'Adding...';
    }

    const formData = new FormData(form);

    fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST',
      headers: {
        'Accept': 'application/json'
      },
      body: formData
    })

    .then(function(response) {

      if (!response.ok) {
        throw new Error('Could not add product');
      }

      return response.json();

    })

    .then(function() {

      if (button) {

        button.textContent = 'Added ✓';

        setTimeout(function() {

          button.disabled = false;

          button.textContent =
            '{{ section.settings.button_text | escape }}';

        }, 1200);

      }

    })

    .catch(function() {

      if (button) {

        button.disabled = false;

        button.textContent = 'Try again';

      }

    });

  });

</script>


{% schema %}

{
  "name": "Shop / Products",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Add to cart button text",
      "default": "Add to cart"
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all products"
    }

  ],

  "presets": [
    {
      "name": "Shop / Products"
    }
  ]

}

{% endschema %}